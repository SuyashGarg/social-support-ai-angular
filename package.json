{
  "name": "social-support-ai-angular",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently -k \"npm:serve:api\" \"npm:serve:web\"",
    "serve:api": "node --env-file-if-exists=.env server/index.js",
    "serve:web": "ng serve --host 0.0.0.0 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "start:production": "NODE_ENV=production node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "@angular/animations": "18.2.14",
    "@angular/common": "18.2.14",
    "@angular/compiler": "18.2.14",
    "@angular/core": "18.2.14",
    "@angular/forms": "18.2.14",
    "@angular/platform-browser": "18.2.14",
    "@angular/router": "18.2.14",
    "country-state-city": "^3.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "openai": "^6.0.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "18.2.21",
    "@angular/cli": "18.2.21",
    "@angular/compiler-cli": "18.2.14",
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.5.4"
  }
}
